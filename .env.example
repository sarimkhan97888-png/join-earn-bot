# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Database URL (from Render PostgreSQL or other provider)
DATABASE_URL=postgresql://user:password@host:port/database

# Webhook URL (your Render/Heroku/VPS URL - set after deploy)
WEBHOOK_URL=https://your-app-name.onrender.com

# Mandatory Group/Channel usernames (without @)
REQUIRED_GROUP=your_group_username
REQUIRED_CHANNEL=your_channel_username

# Your Telegram User ID (get from @userinfobot)
ADMIN_ID=123456789

# Coins per Rupee (default: 3000 coins = ₹1)
COINS_PER_RUPEE=3000